# =============================================================================
# Kimi AI SDK Provider - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys
# Get your API keys at: https://platform.moonshot.cn/

# =============================================================================
# Kimi Chat (Standard API - Moonshot AI)
# =============================================================================

# Your Moonshot AI API key (required for Kimi Chat)
# Get it from: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override the Kimi Chat API base URL (optional)
# Default: https://api.moonshot.ai/v1 (global) or https://api.moonshot.cn/v1 (China)
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# =============================================================================
# Kimi Code (Premium Coding API)
# =============================================================================

# Your Kimi Code API key (required for Kimi Code)
# This is the preferred env var for Kimi Code
KIMI_CODE_API_KEY=sk-kimi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback API key if KIMI_CODE_API_KEY is not set
# KIMI_API_KEY=sk-kimi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override the Kimi Code API base URL (optional)
# Default: https://api.kimi.com/coding/v1
# KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1

# =============================================================================
# Claude Code / Roo Code Integration
# =============================================================================
# If using Kimi Code with Claude Code, set these instead of ANTHROPIC_* vars:
#
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding/v1
# ANTHROPIC_API_KEY=sk-kimi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
