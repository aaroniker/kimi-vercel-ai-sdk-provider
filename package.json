{
  "name": "ai-sdk-provider-kimi",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "del-cli dist *.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.6",
    "@ai-sdk/provider-utils": "^4.0.11"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/node": "^20.17.24",
    "del-cli": "^5.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18",
    "zod": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "kimi",
    "moonshot",
    "ai-sdk",
    "vercel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaroniker/ai-sdk-provider-kimi.git"
  },
  "homepage": "https://ai-sdk.dev/providers/community-providers/custom-providers",
  "bugs": {
    "url": "https://github.com/aaroniker/ai-sdk-provider-kimi/issues"
  }
}
